; mod.ini.example —— 复制到 DLL 同目录，改名 mod.ini 才会生效
;
; 文件放在**模块所在目录**（与 il2cpp_mod.log 同目录）。
; 找不到这个文件时就全用默认值，不会报错。
;
; 行内 # 之后是注释；键名与值两端的空白会被自动去掉。

; ---------------------------------------------------------------------------
; 挂钩一个游戏方法（探针 C）
; 签名为「4 个指针参数」的通用透传钩子，只记录不修改。
; 想知道某个方法有没有被调用、多久调一次、参数长什么样，就填这里。
;
; class  = 要挂钩的类。支持 "命名空间.类名" 或 "类名"（后者按空命名空间找）
; method = 方法名
; args   = 参数个数（用于区分重载；-1 = 不限制，取第一个匹配）
;
; 命中后日志里会出现 [target] hit #N a1=.. a2=.. a3=.. a4=..
;
class =
method =
args = -1

; ---------------------------------------------------------------------------
; 引导完成后自动 dump 一个类的结构（排查字段偏移的正路）
;
; 写「命名空间.类名」，下次注入就会把该类的继承链 + 全部字段
; （类型名 / 偏移 / 当前值）打进日志。
; 拿不到 dump.cs、或者怀疑偏移漂移时最有用 —— 偏移一律以这里打印的为准，
; 不要信任何文档里的旧偏移。
;
dump_class =
; dump 时最多打印多少字段（0 = 不限）
dump_max_fields = 200

; ---------------------------------------------------------------------------
; 热点压测：挂钩 il2cpp_string_new
; 这是个**极高频**函数（每次创建托管字符串都命中），用来压测 detour 在多线程
; 热点路径上的稳定性。默认关 —— 开着会拖慢游戏、刷爆日志，只记录前 10 次。
;
hot_canary = 0
